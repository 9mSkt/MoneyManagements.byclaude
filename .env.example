# Copy this file to .env (git-ignored) and fill in your own values.
# Generate the hash with:  mvnw spring-boot:run -Dspring-boot.run.arguments="hash-password YOUR_PASSWORD"
APP_USERNAME=owner
APP_PASSWORD_HASH=paste-bcrypt-hash-here

# Optional: two-step sign-in. Create a secret with:  mvnw -q spring-boot:run -Dspring-boot.run.arguments="totp-secret"
# APP_TOTP_SECRET=

# Optional: daily copy of all data to a separate Google Sheet (see README).
# GOOGLE_COPY_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: key for the yearly Google Drive export script. Create one with:
#   mvnw -q spring-boot:run -Dspring-boot.run.arguments="export-token"
# EXPORT_TOKEN=
